# Google Console Configuration
# Copy this file to .env and replace with your actual values

# Google Analytics 4 Measurement ID (starts with G-)
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Verification Code
REACT_APP_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# Google Tag Manager Container ID (starts with GTM-)
REACT_APP_GTM_CONTAINER_ID=GTM-XXXXXXX

# Website URL
REACT_APP_WEBSITE_URL=https://www.amlamachines.com

# Environment (development/production)
REACT_APP_ENV=development 